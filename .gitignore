/data/
/dumps/
/uploads/
/storage/
/temp/
/tmp/
*.bak
*.sqlite
*.sqlite3

# Cache and build tools
.cache/
.turbo/
.eslintcache
*.tsbuildinfo
.vercel/
.wrangler/

# Archives that should never be committed
placement-intelligence.zip

# IDE and OS files
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
