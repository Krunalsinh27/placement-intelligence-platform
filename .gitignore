# Dependencies
node_modules/
.pnpm-store/

# Build outputs (dist is ignored everywhere; the rest only at repo root)
dist/
/build/
/out/

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.jks

# Logs and debugging
/logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Testing and coverage
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/

# Local data, uploads and temp files (anchored so source folders with
