# ── Server environment ────────────────────────────────────────────────────────
# Options: development | production | test
NODE_ENV=development

# ── API Server ────────────────────────────────────────────────────────────────
# Port the Express backend listens on
PORT=4000

# ── CORS ──────────────────────────────────────────────────────────────────────
# URL of the web frontend (used for CORS allow-origin)
CLIENT_URL=http://localhost:5173

# ── Logging ───────────────────────────────────────────────────────────────────
# Logging level (fatal | error | warn | info | debug | trace)
LOG_LEVEL=info

# ── MongoDB Connection ────────────────────────────────────────────────────────
# Replace with your MongoDB Atlas connection string (or local mongodb:// URL)
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/placement-platform?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/placement-platform?retryWrites=true&w=majority

# ── Authentication & Sessions (ADR 0003) ──────────────────────────────────────
# Cryptographically random string (minimum 32 characters) used to sign/protect session tokens
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-chars-random-secret
