{
  "name": "placement-platform-root",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant SaaS Placement Intelligence Platform monorepo",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=9.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @placement-platform/api --filter @placement-platform/web run dev",
    "dev:api": "pnpm --filter @placement-platform/api run dev",
    "dev:web": "pnpm --filter @placement-platform/web run dev",
    "build": "pnpm -r run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r run typecheck"
  },
  "prettier": "@placement-platform/config/prettier",
  "devDependencies": {
    "@placement-platform/config": "workspace:*",
    "eslint": "^10.12.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
